{
  "expo": {
    "name": "Pulse",
    "slug": "pulse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pulse",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.slavenslugic.pulse",
      "infoPlist": {
        "NSCameraUsageDescription": "Pulse uses the camera to snap meals and workouts so AI can log them.",
        "NSPhotoLibraryUsageDescription": "Pulse reads photos you pick to log meals and workouts.",
        "NSMicrophoneUsageDescription": "Pulse uses the microphone so you can log by voice.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "8SX4DK48U6",
      "buildNumber": "4",
      "usesAppleSignIn": true,
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0E18",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.slavenslugic.pulse"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07080C",
          "image": "./assets/images/splash-blank.png",
          "imageWidth": 8
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Pulse uses the microphone so you can log by voice."
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Pulse uses the camera to snap meals and workouts so AI can log them.",
          "photosPermission": "Pulse reads photos you pick to log meals and workouts."
        }
      ],
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Pulse uses the camera to snap meals and scan food barcodes.",
          "recordAudioAndroid": false
        }
      ],
      "expo-notifications",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "PulseWidget",
              "displayName": "Pulse",
              "description": "Your streak, calories left and today's quests.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular",
                  "accessoryCircular"
                ],
                "initialLayout": "./src/widgets/pulse-widget.tsx"
              }
            }
          ]
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Pulse reads your steps, workouts, sleep and weight so they log themselves and earn XP.",
          "NSHealthUpdateUsageDescription": "Pulse only reads your Health data to log workouts, sleep and weight. It never writes to Apple Health."
        }
      ],
      "expo-apple-authentication",
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "es",
            "de",
            "fr",
            "it",
            "pt"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#07080C",
    "extra": {
      "eas": {
        "projectId": "a1137655-125e-4b76-bc50-09a305246552"
      }
    },
    "locales": {
      "es": "./locales/es.json",
      "de": "./locales/de.json",
      "fr": "./locales/fr.json",
      "it": "./locales/it.json",
      "pt": "./locales/pt.json"
    }
  }
}
