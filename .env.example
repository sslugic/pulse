# Pulse cloud (Supabase): accounts, AI credits and backup. Both values are public; RLS protects data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# RevenueCat public SDK keys (Project settings → API keys).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Legal pages shown on the credits screen (required by App Review).
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_URL=

# Optional, development only: use your own Gemini key instead of Pulse cloud.
EXPO_PUBLIC_GEMINI_API_KEY=
